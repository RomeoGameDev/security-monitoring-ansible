user nginx;
worker_processes auto;

events {
    worker_connections 2048;
}

http {
    resolver 127.0.0.11 ipv6=off valid=30s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 80 default_server;
        server_name _;

        client_max_body_size 64m;

        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location = /wazuh {
            return 301 /wazuh/;
        }

        location ^~ /wazuh/ {
            set $wazuh_upstream "wazuh-dashboard:5601";

            proxy_pass http://$wazuh_upstream$request_uri;
            proxy_http_version 1.1;
            proxy_buffering off;

            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Prefix /wazuh;

            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location = /zabbix {
            return 301 /zabbix/;
        }

        location ^~ /zabbix/ {
            set $zabbix_upstream "zabbix-web:8080";

            # Prefiks jest zachowywany. Obraz Zabbixa ma symlink /zabbix
            # do katalogu aplikacji, więc PHP widzi poprawny SCRIPT_NAME.
            proxy_pass http://$zabbix_upstream$request_uri;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Prefix /zabbix;

            proxy_read_timeout 300s;
        }

        location = / {
            if ($host = "{{ deployment_ip }}") {
                return 302 {{ gateway_default_path }};
            }

            if ($host = "localhost") {
                return 302 {{ gateway_default_path }};
            }

            set $npm_upstream "nginx-proxy-manager:80";
            proxy_pass http://$npm_upstream$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            set $npm_upstream "nginx-proxy-manager:80";
            proxy_pass http://$npm_upstream$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
