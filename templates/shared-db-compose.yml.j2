services:
  shared-db:
    image: "{{ shared_database_image }}"
    container_name: shared-db
    restart: unless-stopped
    env_file:
      - .env
    environment:
      MARIADB_ROOT_PASSWORD: "${MARIADB_ROOT_PASSWORD}"
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
{% if security_monitoring_bind_persistent_data_effective %}      - "{{ shared_database_directory_effective }}/data:/var/lib/mysql"
{% else %}      - shared_db_data:/var/lib/mysql
{% endif %}      - ./99-shared-database.cnf:/etc/mysql/conf.d/99-shared-database.cnf:ro
    networks:
      database:
        aliases:
          - shared-db
    healthcheck:
      test:
        - CMD
        - healthcheck.sh
        - --connect
        - --innodb_initialized
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 40s

{% if not security_monitoring_bind_persistent_data_effective %}volumes:
  shared_db_data:
    name: shared_db_data

{% endif %}networks:
  database:
    external: true
    name: "{{ docker_database_network }}"
