---
timezone: Europe/Warsaw

# Zatrzymuje lokalne nginx/apache2, jeśli zajmują porty 80/443.
disable_conflicting_web_services: true

# Sieci Docker
docker_proxy_network: proxy
docker_database_network: database

# Katalogi wdrożenia
shared_database_directory: /opt/shared-database
npm_directory: /opt/nginx-proxy-manager
wazuh_directory: /opt/wazuh
wazuh_persistent_directory: /opt/wazuh-persistent
socfortress_directory: /opt/wazuh-socfortress
zabbix_directory: /opt/zabbix

# Wspólna MariaDB dla NPM i Zabbixa
# Poniższe hasła są domyślne dla środowiska testowego.
shared_database_image: mariadb:11.4
shared_database_root_password: 'rootpassword'

npm_database_name: npm
npm_database_user: npm
npm_database_password: 'npmpassword'

zabbix_database_name: zabbix
zabbix_database_user: zabbix
zabbix_database_password: 'zabbixpassword'

# Nginx Proxy Manager
# Wersja przypięta, żeby provisioning API był powtarzalny.
# NPM wymaga minimum 8 znaków, ale nie wymaga znaków specjalnych.
npm_app_image: jc21/nginx-proxy-manager:2.15.0
npm_admin_email: admin@example.com
npm_admin_password: 'changeme'

# Self-signed dla dostępu po IP. HTTPS działa równolegle z HTTP.
npm_self_signed_enabled: true
npm_self_signed_days: 3650
npm_force_ssl: false
npm_self_signed_certificate_directory: "{{ npm_directory }}/certificates"

# Wazuh
wazuh_docker_repository: https://github.com/wazuh/wazuh-docker.git
wazuh_docker_version: v4.14.6

# SOCFortress
socfortress_rules_enabled: true
socfortress_repository: https://github.com/socfortress/Wazuh-Rules.git
socfortress_repository_version: main

# Własne detekcje
custom_wazuh_rules_source: "{{ playbook_dir }}/files/wazuh/custom_rules"
custom_wazuh_decoders_source: "{{ playbook_dir }}/files/wazuh/custom_decoders"

# Zabbix 7.0 LTS
zabbix_server_image: zabbix/zabbix-server-mysql:alpine-7.0-latest
zabbix_web_image: zabbix/zabbix-web-nginx-mysql:alpine-7.0-latest
zabbix_server_name: Zabbix Security Monitoring
zabbix_initial_admin_user: Admin
zabbix_initial_admin_password: zabbix

# Zabbix Agent 2 na hoście
zabbix_agent2_enabled: true
zabbix_agent_server_address: 127.0.0.1
zabbix_agent_allowed_servers: 127.0.0.1,172.16.0.0/12
zabbix_agent_hostname: Zabbix server
zabbix_agent_listen_port: 10050
zabbix_agent_monitor_docker: true
zabbix_agent_host_metadata: linux,docker,ansible
